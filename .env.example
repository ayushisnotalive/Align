SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only, never in the app
SUPABASE_DB_PASSWORD=
SUPABASE_PROJECT_REF_DEV=
SUPABASE_PROJECT_REF_PROD=

# --- AWS (Edge Functions only) ---
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=                # IAM user limited to the two buckets + Rekognition
AWS_SECRET_ACCESS_KEY=
S3_MEDIA_BUCKET=
S3_FACE_BUCKET=                   # private, 24h lifecycle rule
CLOUDFRONT_DOMAIN=

# --- Push / SMS ---
FCM_SERVICE_ACCOUNT_JSON=         # server only
# SMS provider keys + DLT sender ID/template IDs are set in the
# Supabase dashboard: Authentication > Providers > Phone.